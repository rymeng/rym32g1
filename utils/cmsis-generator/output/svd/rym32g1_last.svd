        <size>0x00000FFF</size>
      </addressBlock>
      <registers>
        <register>
          <name>ACR</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <description>FMC Access Control Register</description>
          <fields>
            <field>
              <name>LATENCY</name>
              <msb>3</msb>
              <lsb>0</lsb>
              <access>read-write</access>
              <description>FMC ACR LATENCY [3:0] Bits: Access latency</description>
            </field>
          </fields>
        </register>
        <register>
          <name>KEYR</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <description>FMC Key Register</description>
          <fields>
            <field>
              <name>KEY</name>
              <msb>31</msb>
              <lsb>0</lsb>
              <access>write-only</access>
              <description>FMC KEYR KEY [31:0] Bits: Unlock key</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CR1</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <description>FMC Control Register 1</description>
