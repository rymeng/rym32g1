            </field>
            <field>
              <name>WINH</name>
              <msb>6</msb>
              <lsb>0</lsb>
              <access>read-write</access>
              <description>WWDG CR2 WINH [6:0] Bits: Window high threshold</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IER</name>
          <addressOffset>0x00000100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <description>WWDG Interrupt Enable Register</description>
          <fields>
            <field>
              <name>EW</name>
              <msb>0</msb>
              <lsb>0</lsb>
              <access>read-write</access>
